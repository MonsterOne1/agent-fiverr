    "system_prompt": {
      "type": "string",
      "title": "System Prompt",
      "minLength": 1
    },
    "tool_contracts": {
      "type": "string",
      "title": "Tool Contracts",
      "minLength": 1
    },
    "evals": {
      "type": "string",
      "title": "Evals",
      "minLength": 1
    },
    "deployment_notes": {
      "type": "string",
      "title": "Deployment Notes",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
