    "data_mapping",
    "implementation",
    "tests_run",
    "runbook"
  ],
  "properties": {
    "architecture": {
      "type": "string",
      "title": "Architecture",
      "minLength": 1
    },
    "data_mapping": {
      "type": "string",
      "title": "Data Mapping",
      "minLength": 1
    },
    "implementation": {
      "type": "string",
      "title": "Implementation",
      "minLength": 1
    },
    "tests_run": {
      "type": "string",
      "title": "Tests Run",
      "minLength": 1
    },
    "runbook": {
      "type": "string",
      "title": "Runbook",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
