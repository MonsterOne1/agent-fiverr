    "audience": {
      "type": "string",
      "title": "Audience",
      "minLength": 1
    },
    "source_materials": {
      "type": "string",
      "title": "Source Materials",
      "minLength": 1
    },
    "brand_assets": {
      "type": "string",
      "title": "Brand Assets",
      "minLength": 1
