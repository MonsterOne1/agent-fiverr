    },
    "deliverables": {
      "type": "string",
      "title": "Deliverables",
      "minLength": 1
    },
    "qa_notes": {
      "type": "string",
      "title": "Qa Notes",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
