{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "{{SERVICE_NAME}} Deliverable",
  "type": "object",
  "required": [
    "summary",
    "deliverables",
    "qa_notes"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "title": "Summary",
